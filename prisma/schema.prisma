generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(uuid())
  name          String?
  email         String        @unique
  password      String
  role          String        @default("customer")
  createdAt     DateTime      @default(now())
  cartItems     CartItem[]
  orders        Order[]
  wishlistItems WishlistItem[]
  reviews       Review[]
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Product {
  id          String       @id @default(uuid())
  name        String
  description String
  price       Float
  images      String
  category    String
  material    String
  stock       Int          @default(10)
  featured    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  cartItems   CartItem[]
  orderItems  OrderItem[]
  wishlistItems WishlistItem[]
  reviews     Review[]
}

model CartItem {
  id        String   @id @default(uuid())
  quantity  Int      @default(1)
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id                    String      @id @default(uuid())
  userId                String
  user                  User        @relation(fields: [userId], references: [id])
  items                 OrderItem[]
  total                 Float
  promoCode             String?
  promoDiscount         Float       @default(0)
  status                String      @default("pending")
  firstName             String
  lastName              String
  email                 String
  phone                 String
  address               String
  district              String
  province              String
  zipcode               String
  note                  String?
  paymentMethod         String      @default("bank_transfer")
  paymentStatus         String      @default("pending")
  stripePaymentIntentId String?
  slipImage             String?
  paymentConfirmedAt    DateTime?
  createdAt             DateTime    @default(now())
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model PromoCode {
  id            String   @id @default(uuid())
  code          String   @unique
  discountType  String
  discountValue Float
  minOrder      Float    @default(0)
  maxUsage      Int      @default(100)
  usedCount     Int      @default(0)
  expiresAt     DateTime
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
}
